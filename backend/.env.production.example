# ====================================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ====================================================================================
#
# IMPORTANT SECURITY NOTES:
# 1. Never commit this file with real values to version control
# 2. Copy this file to .env.production and fill in actual values
# 3. Ensure .env.production is listed in .gitignore
# 4. Use strong, randomly generated secrets (min 32 characters)
# 5. Restrict file permissions: chmod 600 .env.production
# 6. Use environment-specific values (don't copy from development)
#
# Generate secure secrets with:
# - Python: python -c "import secrets; print(secrets.token_urlsafe(32))"
# - OpenSSL: openssl rand -base64 32
# ====================================================================================

# ====================
# Application Configuration
# ====================
APP_NAME=多模输入灵感记录器
VERSION=1.0.0
ENVIRONMENT=production
DEBUG=false
TESTING=false

# ====================
# Server Configuration
# ====================
HOST=0.0.0.0
PORT=8000
WORKERS=4                                    # CPU cores * 2 + 1 recommended

# Security: Restrict to specific domains only
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ====================
# Security - CRITICAL
# ====================
# REQUIRED: Must be at least 32 characters for production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING_MIN_32_CHARS

# Encryption key for sensitive data (must be 32 bytes)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=CHANGE_THIS_TO_A_SECURE_ENCRYPTION_KEY_32_BYTES

# JWT Configuration
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ====================
# Database Configuration
# ====================
# Production: Use absolute path or external database
DATABASE_URL=sqlite+aiosqlite:///./data/inspirations.db
DATABASE_ECHO=false

# Connection Pool Settings (for production workloads)
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600                        # 1 hour

# ====================
# Redis Configuration
# ====================
# Production Redis with password recommended
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=                              # Set a strong password
REDIS_DB=0
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=5

# ARQ Task Queue (use separate DB)
ARQ_REDIS_URL=redis://redis:6379/1
ARQ_MAX_JOBS=100
ARQ_JOB_TIMEOUT=600                          # 10 minutes

# ====================
# LLM API Configuration - REQUIRED
# ====================
# OpenAI-compatible API (production should use OpenAI or reliable provider)
OPENAI_API_KEY=sk-YOUR-OPENAI-API-KEY-HERE
OPENAI_BASE_URL=https://api.openai.com/v1   # Use official OpenAI for production
OPENAI_MODEL=gpt-3.5-turbo                   # or gpt-4 for better quality
OPENAI_MAX_TOKENS=1000
OPENAI_TEMPERATURE=0.7

# Azure OpenAI (alternative)
# AZURE_OPENAI_API_KEY=your-azure-key
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT=your-deployment-name

# ====================
# Speech-to-Text Configuration - REQUIRED
# ====================
# Deepgram API for voice transcription
DEEPGRAM_API_KEY=YOUR-DEEPGRAM-API-KEY-HERE
DEEPGRAM_MODEL=nova-2
DEEPGRAM_LANGUAGE=zh-CN

# ====================
# OCR Configuration - REQUIRED
# ====================
# Google Cloud Vision API
# Store credentials file securely, not in repository
GOOGLE_APPLICATION_CREDENTIALS=/app/credentials/google-cloud-vision.json
OCR_CONFIDENCE_THRESHOLD=0.7

# ====================
# Notion Integration - REQUIRED
# ====================
# Notion API credentials
NOTION_API_KEY=secret_YOUR_NOTION_INTEGRATION_SECRET_HERE
NOTION_DATABASE_ID=YOUR_NOTION_DATABASE_ID_HERE

# ====================
# Sync Configuration
# ====================
SYNC_INTERVAL=1800                           # 30 minutes
SYNC_ON_NETWORK=true
SYNC_MAX_RETRIES=5
SYNC_RETRY_DELAY_BASE=4
SYNC_BATCH_SIZE=10

# ====================
# File Storage
# ====================
UPLOAD_DIR=/app/uploads
AUDIO_DIR=/app/uploads/audio
IMAGE_DIR=/app/uploads/images
MAX_UPLOAD_SIZE=10485760                     # 10MB

# Voice recording limits (seconds)
MAX_VOICE_DURATION=300                       # 5 minutes
MIN_VOICE_DURATION=1

# Image upload limits
MAX_IMAGE_SIZE=5242880                       # 5MB
ALLOWED_IMAGE_FORMATS=jpg,jpeg,png,webp

# ====================
# Data Volume Constraints
# ====================
MAX_RECORDS_PER_USER=1000
STORAGE_WARNING_THRESHOLD=900

# ====================
# Request Configuration
# ====================
REQUEST_TIMEOUT=30
EXTERNAL_API_TIMEOUT=30
MAX_RETRIES=3
RETRY_DELAY=1.0

# ====================
# Rate Limiting - CRITICAL for Production
# ====================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100                      # requests per window
RATE_LIMIT_WINDOW=60                         # window size in seconds

# ====================
# Cost Control
# ====================
MAX_DAILY_TOKENS=100000
COST_PER_TOKEN=0.000002

# ====================
# Logging - IMPORTANT
# ====================
LOG_LEVEL=INFO                               # Use INFO or WARNING for production
LOG_FORMAT=json                              # Structured logging for production
LOG_DIR=/app/logs
LOG_FILE=/app/logs/app.log
LOG_MAX_SIZE=104857600                       # 100MB
LOG_BACKUP_COUNT=10
LOG_ROTATION=midnight

# ====================
# Monitoring & Observability
# ====================
# Metrics
ENABLE_METRICS=true
METRICS_PORT=9090

# Health Checks
ENABLE_HEALTHCHECK=true
HEALTHCHECK_PATH=/api/v1/health

# Sentry Error Tracking (highly recommended for production)
SENTRY_DSN=https://YOUR_SENTRY_DSN@sentry.io/YOUR_PROJECT_ID
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1                # 10% of transactions

# ====================
# CORS Configuration - CRITICAL
# ====================
# IMPORTANT: Never use "*" in production
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=*

# ====================
# Feature Flags
# ====================
ENABLE_VOICE_INPUT=true
ENABLE_IMAGE_OCR=true
ENABLE_TEXT_INPUT=true
ENABLE_NOTION_SYNC=true
ENABLE_AI_PROCESSING=true

FEATURE_AUTO_CLASSIFY=true
FEATURE_AUTO_SUMMARIZE=true
FEATURE_OFFLINE_MODE=true
FEATURE_BACKGROUND_SYNC=true
FEATURE_ENCRYPTION=false                     # Enable for sensitive data

# ====================
# Performance Settings
# ====================
# Caching
CACHE_ENABLED=true
CACHE_TTL=300                                # 5 minutes
CACHE_MAX_SIZE=1000

# ====================
# Development Settings - MUST BE DISABLED
# ====================
RELOAD=false                                 # MUST be false in production
DOCS_ENABLED=false                           # Disable API docs in production

# ====================================================================================
# DEPLOYMENT CHECKLIST - Verify before going live
# ====================================================================================
#
# [ ] All API keys are set with real production values
# [ ] SECRET_KEY is strong and unique (min 32 chars)
# [ ] ENCRYPTION_KEY is properly generated
# [ ] DEBUG=false
# [ ] RELOAD=false
# [ ] DOCS_ENABLED=false
# [ ] CORS_ORIGINS restricted to specific domains (no "*")
# [ ] ALLOWED_HOSTS restricted to specific domains
# [ ] Redis password is set
# [ ] Database backups are configured
# [ ] Sentry DSN is configured for error tracking
# [ ] Log aggregation is set up
# [ ] SSL/TLS certificates are installed
# [ ] Security headers are configured
# [ ] Rate limiting is enabled
# [ ] Health checks are working
# [ ] Monitoring dashboards are set up
# [ ] File permissions are restricted (chmod 600)
# [ ] Secrets are not in version control
# [ ] Environment variables are set in deployment platform
#
# ====================================================================================
