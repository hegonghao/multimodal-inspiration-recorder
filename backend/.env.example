# Application Configuration
APP_NAME=多模输入灵感记录器
VERSION=1.0.0
MOBILE_APP_VERSION=1.0.2
MOBILE_APP_BUILD=3
# Public HTTPS URL of the Android APK. Leave empty until an APK is published.
MOBILE_APP_APK_URL=
MOBILE_APP_RELEASE_NOTES=
MOBILE_APP_FORCE_UPDATE=false
ENVIRONMENT=development
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000
ALLOWED_HOSTS=["*"]
ALLOWED_ORIGINS=["*"]

# Security
SECRET_KEY=your-secret-key-here-change-in-production-min-32-chars

# Database (SQLite)
DATABASE_URL=sqlite+aiosqlite:///./data/inspirations.db

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# LLM API Configuration (Ollama/OpenAI compatible)
OPENAI_API_KEY=not-needed-for-ollama
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_MODEL=llama3.1
OPENAI_MAX_TOKENS=1000
OPENAI_TEMPERATURE=0.7

# Notion Integration (Optional)
NOTION_TOKEN=
NOTION_DATABASE_ID=
NOTION_SYNC_ENABLED=false
NOTION_SYNC_INTERVAL_MINUTES=15
NOTION_SYNC_BATCH_SIZE=10

# Speech-to-Text (Optional)
DEEPGRAM_API_KEY=

# OCR (Optional - PaddleOCR v6 asynchronous jobs)
PADDLEOCR_API_URL=https://paddleocr.aistudio-app.com/api/v2/ocr/jobs
PADDLEOCR_TOKEN=
PADDLEOCR_MODEL=PP-OCRv6
PADDLEOCR_POLL_INTERVAL=5
PADDLEOCR_JOB_TIMEOUT=300
PADDLEOCR_REQUEST_TIMEOUT=60

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=text

# Monitoring (Optional)
METRICS_ENABLED=true
SENTRY_DSN=
