# ====================
# Application Configuration
# ====================
APP_NAME=多模输入灵感记录器
VERSION=1.0.0
MOBILE_APP_VERSION=1.0.1
MOBILE_APP_BUILD=2
# Public HTTPS URL of the Android APK. Leave empty until an APK is published.
MOBILE_APP_APK_URL=
MOBILE_APP_RELEASE_NOTES=
MOBILE_APP_FORCE_UPDATE=false
ENVIRONMENT=development
DEBUG=true

# ====================
# Server Configuration
# ====================
HOST=0.0.0.0
PORT=8000
ALLOWED_HOSTS=localhost,127.0.0.1
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ====================
# Security
# ====================
SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ENCRYPTION_KEY=your-encryption-key-for-sensitive-data-32-bytes

# ====================
# Database Configuration
# ====================
# SQLite database path (relative to project root)
DATABASE_URL=sqlite+aiosqlite:///./data/inspirations.db
DATABASE_ECHO=false

# ====================
# Redis Configuration
# ====================
REDIS_URL=redis://localhost:6379
REDIS_DB=0
# Required when Redis is run by docker-compose
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
REDIS_PASSWORD=change-this-to-a-random-value

# ====================
# LLM API Configuration
# ====================
# OpenAI-compatible API
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_MODEL=llama3.1
OPENAI_MAX_TOKENS=1000
OPENAI_TEMPERATURE=0.7

# Azure OpenAI (optional alternative)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=

# ====================
# Speech-to-Text Configuration
# ====================
# Deepgram API for voice transcription
DEEPGRAM_API_KEY=your-deepgram-api-key
DEEPGRAM_MODEL=nova-2
DEEPGRAM_LANGUAGE=zh-CN

# ====================
# OCR Configuration (PaddleOCR v6)
# ====================
# https://paddleocr.aistudio-app.com/api/v2/ocr/jobs
PADDLEOCR_API_URL=https://paddleocr.aistudio-app.com/api/v2/ocr/jobs
PADDLEOCR_TOKEN=your-paddleocr-token
PADDLEOCR_MODEL=PP-OCRv6
PADDLEOCR_POLL_INTERVAL=5
PADDLEOCR_JOB_TIMEOUT=300
PADDLEOCR_REQUEST_TIMEOUT=60
OCR_CONFIDENCE_THRESHOLD=0.7

# ====================
# Notion Integration
# ====================
NOTION_TOKEN=your-notion-integration-token
NOTION_DATABASE_ID=your-notion-database-id

# ====================
# Sync Configuration
# ====================
# ARQ task queue settings
SYNC_INTERVAL=1800
SYNC_ON_NETWORK=true
SYNC_MAX_RETRIES=5
SYNC_RETRY_DELAY_BASE=4
SYNC_BATCH_SIZE=10

# ====================
# File Storage
# ====================
# Local file storage paths
UPLOAD_DIR=./uploads
AUDIO_DIR=./uploads/audio
IMAGE_DIR=./uploads/images
MAX_UPLOAD_SIZE=10485760

# Voice recording limits (in seconds)
MAX_VOICE_DURATION=300
MIN_VOICE_DURATION=1

# Image upload limits
MAX_IMAGE_SIZE=5242880
ALLOWED_IMAGE_FORMATS=jpg,jpeg,png,webp

# ====================
# Data Volume Constraints
# ====================
MAX_RECORDS_PER_USER=1000
STORAGE_WARNING_THRESHOLD=900

# ====================
# Request Configuration
# ====================
REQUEST_TIMEOUT=30
MAX_RETRIES=3
RETRY_DELAY=1.0

# ====================
# Rate Limiting
# ====================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600

# ====================
# Cost Control
# ====================
MAX_DAILY_TOKENS=100000
COST_PER_TOKEN=0.000002

# ====================
# Logging
# ====================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_DIR=./logs

# ====================
# Monitoring
# ====================
METRICS_ENABLED=true
SENTRY_DSN=
PROMETHEUS_PORT=9090

# ====================
# CORS Configuration
# ====================
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=true

# ====================
# Feature Flags
# ====================
FEATURE_AUTO_CLASSIFY=true
FEATURE_AUTO_SUMMARIZE=true
FEATURE_OFFLINE_MODE=true
FEATURE_BACKGROUND_SYNC=true
FEATURE_ENCRYPTION=false

# ====================
# Performance Settings
# ====================
# Worker settings for Uvicorn
WORKERS=1
WORKER_CONNECTIONS=1000

# Database connection pool
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ====================
# Development Settings
# ====================
# Enable/disable hot reload
RELOAD=true

# Enable/disable API docs
DOCS_ENABLED=true
